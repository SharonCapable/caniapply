# This is a TEMPLATE, committed to git. Put real values in .env.local (gitignored).

# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Optional. Google retires model ids on their own schedule; when that happens the API
# returns "no longer available" and names the replacement. Set it here - no code change.
# Use gemini-flash-lite-latest to always track the newest flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
